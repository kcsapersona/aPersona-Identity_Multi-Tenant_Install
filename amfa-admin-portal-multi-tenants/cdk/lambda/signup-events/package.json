{
  "name": "signup-events",
  "version": "1.0.0",
  "description": "DynamoDB Stream consumer: D10 metric + ops notification for every SIGNUP# state transition",
  "main": "index.mjs",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild ./index.mjs --entry-names=./[name] --bundle --minify --sourcemap --platform=node --target=node20.16 --outdir=dist --metafile=dist/meta.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "3.1146.0",
    "@aws-sdk/client-sns": "3.1146.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@aws-sdk/client-dynamodb": "3.1146.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
