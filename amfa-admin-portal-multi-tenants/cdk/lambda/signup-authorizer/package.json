{
  "name": "signup-authorizer",
  "version": "1.0.0",
  "description": "Lambda authorizer for the tenant registration API: API key + source-IP allowlist from Secrets Manager",
  "main": "index.mjs",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild ./index.mjs --entry-names=./[name] --bundle --minify --sourcemap --platform=node --target=node20.16 --outdir=dist --external:@aws-sdk/*",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
