{
  "name": "billing-smoke",
  "version": "1.0.0",
  "description": "Smoke test for the 722lic.works billing client from inside the VPC (IP-pinned key)",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild ./*.mjs --entry-names=./[name] --bundle --minify --sourcemap --platform=node --target=node20.16 --outdir=dist --external:@aws-sdk/*",
    "test": "node --test ../shared/billing/test/*.test.mjs"
  },
  "dependencies": {}
}
