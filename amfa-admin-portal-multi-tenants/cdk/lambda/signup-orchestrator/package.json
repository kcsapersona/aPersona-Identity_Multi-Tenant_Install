{
  "name": "signup-orchestrator",
  "version": "1.0.0",
  "description": "Tenant self-signup orchestrator (W8): license, provision-tenant, group, billing backfill, activation (design doc 3.4 a-j, D16)",
  "main": "index.mjs",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild ./index.mjs --entry-names=./[name] --bundle --minify --sourcemap --platform=node --target=node20.16 --outdir=dist --metafile=dist/meta.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1146.0",
    "@aws-sdk/client-lambda": "3.1146.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
