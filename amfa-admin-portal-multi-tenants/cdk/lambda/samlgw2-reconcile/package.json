{
  "name": "samlgw2-reconcile",
  "version": "1.0.0",
  "description": "Removes samlgw2 customers and IT orgs that no longer have a tenant or org in the admin portal",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "build": "rm -rf dist && esbuild ./index.mjs --entry-names=./[name] --bundle --minify --sourcemap --platform=node --target=node20.16 --outdir=dist --external:@aws-sdk/*",
    "test": "node --test ./*.test.mjs"
  },
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "esbuild": "^0.25.0"
  }
}
